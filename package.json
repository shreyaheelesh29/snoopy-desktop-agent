{
  "name": "snoopy-desktop-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:voice": "powershell -NoProfile -ExecutionPolicy Bypass -File ./setup-voice.ps1",
    "build": "vite build",
    "start": "electron .",
    "pack:win": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-voice-runtime.ps1 && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "openai": "^4.80.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.snoopy.desktop",
    "productName": "Snoopy",
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json",
      "!**/.env*",
      "!**/*.log",
      "!**/voice-listener.py"
    ],
    "extraResources": [
      {
        "from": "build-resources/snoopy.ico",
        "to": "snoopy.ico"
      },
      {
        "from": "src/main/voice-listener.py",
        "to": "voice/voice-listener.py"
      },
      {
        "from": ".packaging/voice-python",
        "to": "voice/python"
      },
      {
        "from": "models/vosk-model-small-en-in-0.4",
        "to": "voice/model"
      }
    ],
    "win": {
      "icon": "build-resources/snoopy.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Snoopy",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Snoopy-${version}-portable.${ext}"
    }
  }
}
